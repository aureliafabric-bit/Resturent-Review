<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Review Our Hotel</title>
    <style>
        body { font-family: Arial, sans-serif; text-align: center; padding: 40px 20px; background-color: #f4f7f6; }
        .container { max-width: 400px; margin: 0 auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        h2 { color: #333; margin-bottom: 10px; }
        p { color: #666; font-size: 14px; margin-bottom: 20px; }
        textarea { width: 100%; height: 100px; padding: 10px; border: 1px solid #ddd; border-radius: 8px; font-size: 15px; resize: none; margin-bottom: 20px; }
        button { background-color: #4285F4; color: white; border: none; padding: 15px; width: 100%; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; transition: 0.3s; }
        button:hover { background-color: #357AE8; }
    </style>
</head>
<body>

    <div class="container">
        <h2>Rate Your Stay! ⭐⭐⭐⭐⭐</h2>
        <p>Aapki suvidha ke liye humne ek review draft kiya hai. Aap ise edit bhi kar sakte hain.</p>
        
        <textarea id="reviewText"></textarea>
        
        <button onclick="copyAndRedirect()">Copy & Go to Google</button>
    </div>

    <script>
        const reviews = [
            "Had an amazing stay! The rooms were perfectly clean, and the staff was incredibly polite and helpful. Highly recommend this hotel to everyone.",
            "Excellent service and a great location. The food was delicious and the ambiance was perfect. Will definitely visit again!",
            "A wonderful experience from check-in to check-out. The hospitality here is top-notch. Loved the vibe of the place. 5 stars!",
            "Great value for money. The room was spacious, comfortable, and well-maintained. The front desk team made our stay very easy."
        ];

        window.onload = function() {
            const randomReview = reviews[Math.floor(Math.random() * reviews.length)];
            document.getElementById('reviewText').value = randomReview;
        };

        function copyAndRedirect() {
            const textToCopy = document.getElementById('reviewText').value;
            
            navigator.clipboard.writeText(textToCopy).then(() => {
                // Aapka exact Google Review Link yahan update ho gaya hai
                const googleReviewLink = "https://search.google.com/local/writereview?placeid=ChIJuQBkcgBzQjkRCMuBF4kGYdQ"; 
                window.location.href = googleReviewLink;
            }).catch(err => {
                alert("Copy karne mein error aaya. Please manually copy karein.");
            });
        }
    </script>

</body>
</html>
